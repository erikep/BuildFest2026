// Person A owns this directory; schema matches FIRSTTASK.md Event shape.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Event {
  id          Int    @id @default(autoincrement())
  title       String
  date        String
  location    String
  description String
}
