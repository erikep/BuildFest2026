// Person A owns this directory. Schema supports MVP + stretch (README.md).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// User and roles (MVP) — role: NONPROFIT_MANAGER | VOLUNTEER | ASSISTEE
// ---------------------------------------------------------------------------

model User {
  id                    String                   @id @default(cuid())
  email                 String?
  name                  String?
  role                  String
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  notificationPreferences NotificationPreference[]
  volunteerInterests    VolunteerInterest[]
  orders                Order[]
}

// ---------------------------------------------------------------------------
// Event (existing + impact fields + relations)
// ---------------------------------------------------------------------------

model Event {
  id                    Int              @id @default(autoincrement())
  title                 String
  date                  String
  location              String
  description           String
  foodDistributedAmount String?
  foodWastePrevented    String?
  createdAt             DateTime?
  updatedAt             DateTime?
  inventoryItems        InventoryItem[]
  checkIns              CheckIn[]
  feedbacks             Feedback[]
  orders                Order[]
}

// ---------------------------------------------------------------------------
// Landing / client (MVP)
// ---------------------------------------------------------------------------

model Resource {
  id          Int     @id @default(autoincrement())
  title       String
  url         String
  description String?
  sortOrder   Int?
  createdAt   DateTime @default(now())
}

model ActionItem {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Notifications and volunteer (MVP)
// ---------------------------------------------------------------------------

// channel: EMAIL | SMS | PUSH
model NotificationPreference {
  id        Int                 @id @default(autoincrement())
  userId    String?
  channel   String
  value     String
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now())
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model VolunteerInterest {
  id        Int     @id @default(autoincrement())
  userId    String?
  name      String?
  email     String?
  phone     String?
  interests String?
  createdAt DateTime @default(now())
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Inventory (MVP)
// ---------------------------------------------------------------------------

model InventoryItem {
  id        Int      @id @default(autoincrement())
  eventId   Int?
  name      String
  quantity  Int?
  unit      String?
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  recipes   Recipe[]
}

// ---------------------------------------------------------------------------
// Demographics and feedback (MVP)
// ---------------------------------------------------------------------------

model CheckIn {
  id                 Int       @id @default(autoincrement())
  eventId            Int
  firstName          String
  lastName           String?
  householdSize      Int?
  zipCode            String?
  firstTimeVisitor   Boolean   @default(true)
  foodReceivedAmount String?
  createdAt          DateTime  @default(now())
  event              Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  feedbacks          Feedback[]
}

model Feedback {
  id        Int     @id @default(autoincrement())
  checkInId Int?
  eventId   Int?
  rating    Int?
  comment   String?
  createdAt DateTime @default(now())
  checkIn   CheckIn? @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Stretch
// ---------------------------------------------------------------------------

// source: CLIENT | STAFF
model Recipe {
  id              Int         @id @default(autoincrement())
  inventoryItemId Int?
  title           String
  instructions    String?
  source          String
  pdfUrl          String?
  createdAt       DateTime    @default(now())
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
}

// type: SHELF | KITCHEN
model Location {
  id        Int          @id @default(autoincrement())
  name      String
  type      String
  address   String?
  latitude  Float?
  longitude Float?
  url       String?
  createdAt DateTime     @default(now())
}

// status: PENDING | CONFIRMED | PICKED_UP
model Order {
  id           Int         @id @default(autoincrement())
  userId       String?
  eventId      Int?
  items        String?
  status       String
  pickupWindow String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  event        Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
}

model DonorRequest {
  id        Int      @id @default(autoincrement())
  title     String
  items     String?
  status    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
