# Copy this file to .env and adjust if needed
DATABASE_URL="file:./dev.db"

# Notifications - Notify me feature (optional)

# Email via Resend (https://resend.com) - free tier: 100/day, 3000/month
RESEND_API_KEY="re_xxxxx"
# Optional: custom from address (default: onboarding@resend.dev - only sends to your Resend account email)
# RESEND_FROM_EMAIL="Tommie Shelf <notify@yourdomain.com>"

# SMS via Twilio (https://twilio.com) - trial: $15 credit
# TWILIO_ACCOUNT_SID="ACxxxxx"
# TWILIO_AUTH_TOKEN="xxxxx"
# Use ONE of these:
# TWILIO_PHONE_NUMBER="+15551234567"
# TWILIO_MESSAGING_SERVICE_SID="MGxxxxx"
